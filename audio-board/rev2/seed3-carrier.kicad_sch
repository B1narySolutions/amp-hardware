	)
	(text "Q1: reverse-polarity protection for 5V_IN (J3)"
		(exclude_from_sim no)
		(at 52.324 83.82 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "61445f20-03e0-4f89-9622-10580c4e81e6")
	)
	(text "Mono to both ears / 16-64 ohm headphones"
		(exclude_from_sim no)
		(at 289.56 21.844 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "68a60ad7-064d-4b8c-b236-c18118f228be")
	)
	(text "CONTROLS & DISPLAY"
		(exclude_from_sim no)
		(at 106.68 71.12 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "82c632f3-7ae7-45d0-acdc-fc6fdb2fbed2")
	)
	(text "U2: TPA6132A2 DirectPath, gain 0 dB (G0 high, G1 low). Outputs sit at 0 V: no output caps.\nC12/C13 with the 19.8k internal input R: 1.7 Hz high-pass. EN = HP_EN, pulled low by R26.\nLayout: run SGND straight to the J5 sleeve pin. HPVDD/HPVSS are made inside U2: caps only."
		(exclude_from_sim no)
		(at 291.08 96.52 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9667a2ff-b0a1-4170-8d5d-8b055b0aef20")
	)
	(text "AUDIO_OUT_2 feeds the speaker amp (J8) and J2.\nFirmware mutes it when HP_DETECT shows headphones."
		(exclude_from_sim no)
		(at 118.11 232.41 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9fd55915-013b-483c-9d60-acdcbfa75931")
	)
	(text "R17 = 1M guitar input load. No input level pot: trim gain in firmware."
		(exclude_from_sim no)
		(at 17.78 62.23 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "a78301e2-107b-4973-928e-941a1b4d216a")
	)
	(text "POWER & BIAS"
		(exclude_from_sim no)
		(at 17.78 71.12 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "a9c86a61-e146-44a9-9a21-52d439089c5c")
	)
	(text "J3 goes to the power board (JST-XH, 8 pins). Pins 5-7 are 3.3 V logic: nothing above 3.3 V on them.\nSPK_MUTE is open drain. The power board pulls it up, so the speaker amp stays muted unless SPK_EN is high."
		(exclude_from_sim no)
		(at 17.78 284.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b4f7dbd4-6681-447c-abe3-b1391231b6e1")
	)
	(text "POWER BOARD CONNECTOR"
		(exclude_from_sim no)
		(at 17.78 243.84 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "b6e62c11-ddd3-46b0-a9cf-36c036ed74c3")
	)
