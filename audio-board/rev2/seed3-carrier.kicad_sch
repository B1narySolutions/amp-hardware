	(text "HEADPHONE OUTPUT"
		(exclude_from_sim no)
		(at 289.56 19.05 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "134724f4-3f1c-4af4-a0e3-a8cde2f06337")
	)
	(text "HP_EN (Daisy pin 33) drives U2 EN directly. R26 holds it low, so U2 stays off while the Daisy is\nabsent, booting, in DFU or being reset. The firmware feeds the STM32 internal watchdog (IWDG) only from\nthe audio callback: if audio stops, the STM32 resets, its pins float, and R26 (U2) and R37 (Q4, speaker)\nmute both amps. The speaker amp mute is SPK_MUTE on J3."
		(exclude_from_sim no)
		(at 289.56 222.25 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "22844f4b-81fb-4fb8-ad39-52909926a6e5")
	)
	(text "HEADPHONE BUFFER"
		(exclude_from_sim no)
		(at 154.94 17.78 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "24450a35-782f-4873-87e3-2f1e98f846b7")
	)
	(text "DAISY SEED"
		(exclude_from_sim no)
		(at 175.26 71.12 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "2f9e93f4-8c14-47c7-9c34-3080e57850d8")
	)
	(text "Op-amp power rails"
		(exclude_from_sim no)
		(at 34.29 126.746 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "34fc5d1d-bbdf-4e05-a1bd-4706e7db4ce6")
	)
	(text "AUDIO INPUT"
		(exclude_from_sim no)
		(at 17.78 17.78 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "39e876eb-d8b3-467b-934d-ddeafe9ee5c2")
	)
	(text "Headphone detect: J5 pins 5-6 are an isolated N-O switch\nthat closes on plug insertion, so HP_DETECT is LOW with\nheadphones in. Bring-up: short TP11 to GND to simulate it."
		(exclude_from_sim no)
		(at 289.56 138.43 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "3ba938b3-b47c-4b86-952a-c2cfcb21c716")
	)
	(text "SPEAKER / LINE SEND, AUX INPUT"
		(exclude_from_sim no)
		(at 17.78 187.96 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "440b5765-5589-46b4-8069-e1dafe2be3e1")
	)
	(text "OUTPUT MUTE"
		(exclude_from_sim no)
		(at 289.56 157.48 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "48377894-3736-41bc-a476-8ea0881d7196")
	)
	(text "SEED3 BREAKOUT HEADERS"
		(exclude_from_sim no)
		(at 175.26 176.53 0)
