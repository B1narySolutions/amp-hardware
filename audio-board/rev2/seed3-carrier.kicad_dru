(version 1)

# Min / default (opt) / max for tracks and vias. Board Setup holds the absolute minimums and the
# net class widths; these rules add the upper limits. See "Design rules" in DESIGN.md.

(rule "Signal track width"
	(condition "A.Type == 'Track' && A.NetClass == 'Default' && A.NetName != 'GND'")
	(constraint track_width (min 0.2mm) (opt 0.2mm) (max 0.5mm)))

(rule "GND track width"
	(condition "A.Type == 'Track' && A.NetName == 'GND'")
	(constraint track_width (min 0.2mm) (opt 0.5mm) (max 2mm)))

(rule "Power track width"
	(condition "A.Type == 'Track' && A.NetClass == 'Power'")
	(constraint track_width (min 0.5mm) (opt 1mm) (max 2mm)))

# Neck-down at fine-pitch power pins. Inside the IC's courtyard a Power track defaults to the pad width,
# so the router starts narrow at the pin. Switch to 1 mm once outside the courtyard.
# These come after "Power track width" because the last matching rule wins.
(rule "Power neck-down at U1"
	(condition "A.Type == 'Track' && A.NetClass == 'Power' && A.intersectsCourtyard('U1')")
	(constraint track_width (min 0.3mm) (opt 0.5mm) (max 2mm)))

(rule "Power neck-down at U2"
	(condition "A.Type == 'Track' && A.NetClass == 'Power' && A.intersectsCourtyard('U2')")
	(constraint track_width (min 0.2mm) (opt 0.25mm) (max 2mm)))

# Only the two via sizes in the presets: 0.6/0.3 and 0.8/0.4.
(rule "Via size"
	(condition "A.Type == 'Via'")
	(constraint via_diameter (min 0.6mm) (max 0.8mm))
	(constraint hole_size (min 0.3mm) (max 0.4mm)))

# Through-hole pads join copper zones with thermal-relief spokes so an iron can heat them (jack sleeves, GND pins
# on J3/J4/J8, the Daisy sockets). SMD pads and vias stay solid. Applies to every zone, including ones added later.
(rule "Thermal reliefs on through-hole pads"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
	(constraint zone_connection thermal_reliefs)
	(constraint thermal_relief_gap (min 0.5mm))
	(constraint thermal_spoke_width (min 0.5mm)))

(rule "Power via size"
	(condition "A.Type == 'Via' && A.NetClass == 'Power'")
	(constraint via_diameter (min 0.6mm) (opt 0.8mm) (max 0.8mm))
	(constraint hole_size (min 0.3mm) (opt 0.4mm) (max 0.4mm)))
